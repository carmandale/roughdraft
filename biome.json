{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!.context",
      "!.roughdraft-state",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/node_modules",
      "!**/dist",
      "!docs/goals/**/.goalbuddy-board",
      "!specs/**/.codex-round*",
      "!specs/**/.gate-*-timestamp",
      "!specs/**/artifacts/codex-implement-approval-state.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      }
    }
  }
}
